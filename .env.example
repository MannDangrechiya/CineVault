# CineVault OS — Local Development Environment Configuration Template
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT ONLY. DO NOT COMMIT .env TO GIT.

# Environment Mode
ENVIRONMENT=local
LOG_LEVEL=debug

# PostgreSQL Database Configuration (Local Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cinevault
POSTGRES_USER=cinevault_dev
POSTGRES_PASSWORD=dev_postgres_password_change_me
POSTGRES_MAX_CONNECTIONS=100

# PgBouncer Connection Pooler (Local Docker)
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000

# Valkey Cache Cluster (Local Docker RESP)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=dev_valkey_password_change_me

# RabbitMQ Queue Broker (Local Docker AMQP)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=cinevault_dev
RABBITMQ_DEFAULT_PASS=dev_rabbitmq_password_change_me

# Keycloak Identity Server (Local Docker OIDC)
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=dev_keycloak_admin_password_change_me
KEYCLOAK_REALM=cinevault-dev
KEYCLOAK_CLIENT_ID=cinevault-api-gateway

# Kong API Gateway (Local Docker)
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_DATABASE=off

# Object Storage Target (Local S3 Emulation / Cloudflare R2 Mock)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=dev_s3_access_key
S3_SECRET_ACCESS_KEY=dev_s3_secret_key
S3_RAW_PAYLOADS_BUCKET=cinevault-dev-raw-payloads
S3_ARTWORK_BUCKET=cinevault-dev-artwork

# Observability Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
WAZUH_MANAGER_HOST=localhost

# AI Provider Integration (ADR-004)
# Options for AI_PROVIDER: mock (default for dev/tests), openai, gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
