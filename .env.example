# CineVault OS — Environment Configuration Reference
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT ONLY. DO NOT COMMIT .env TO GIT.
#
# Variable Classification:
#   [REQUIRED]  = Must be set for the application to start
#   [OPTIONAL]  = Has a sensible default; override as needed
#   [SECRET]    = Contains sensitive credentials; never expose publicly
#   [PUBLIC]    = Safe to expose (non-secret configuration)

# ─── Environment Mode ─────────────────────────────────────────────────────────
# [REQUIRED] [PUBLIC] Controls auth strictness, logging, seed fallback behavior.
# Values: local_development | test | staging | production
ENVIRONMENT=local_development

# [OPTIONAL] [PUBLIC] Log verbosity. Defaults: debug (local_development), info (production)
LOG_LEVEL=debug

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
# [REQUIRED] [PUBLIC] Database connection parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cinevault

# [REQUIRED] [SECRET] Database credentials — MUST change for production
POSTGRES_USER=cinevault_dev
POSTGRES_PASSWORD=dev_postgres_password_change_me
POSTGRES_MAX_CONNECTIONS=100

# ─── PgBouncer Connection Pooler ──────────────────────────────────────────────
# [OPTIONAL] [PUBLIC] Connection pooler settings
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000

# ─── Valkey Cache (Linux Foundation RESP) ─────────────────────────────────────
# [OPTIONAL] [PUBLIC] Cache connection
VALKEY_HOST=localhost
VALKEY_PORT=6379

# [OPTIONAL] [SECRET] Cache authentication (empty = no auth for local dev)
VALKEY_PASSWORD=dev_valkey_password_change_me

# ─── RabbitMQ Message Broker ──────────────────────────────────────────────────
# [OPTIONAL] [PUBLIC] Queue broker connection
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# [OPTIONAL] [SECRET] Queue broker credentials — MUST change for production
RABBITMQ_DEFAULT_USER=cinevault_dev
RABBITMQ_DEFAULT_PASS=dev_rabbitmq_password_change_me

# ─── Authentication (Keycloak OIDC) ───────────────────────────────────────────
# [REQUIRED for OIDC auth] [PUBLIC] Keycloak identity server
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin

# [REQUIRED for OIDC auth] [SECRET] Keycloak admin password
KEYCLOAK_ADMIN_PASSWORD=dev_keycloak_admin_password_change_me

# [REQUIRED for OIDC auth] [PUBLIC] OIDC realm and client configuration
KEYCLOAK_REALM=cinevault-dev
KEYCLOAK_CLIENT_ID=cinevault-api-gateway
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/cinevault-dev
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/cinevault-dev/protocol/openid-connect/certs

# ─── JWT Local Development Secret ─────────────────────────────────────────────
# [REQUIRED] [SECRET] HS256 signing key for local dev tokens.
# Production uses RS256 via Keycloak JWKS — this value is rejected outside local_development.
JWT_SECRET_KEY=cinevault-local-dev-jwt-secret-CHANGE-IN-PROD-00000000

# ─── CORS Configuration ──────────────────────────────────────────────────────
# [OPTIONAL] [PUBLIC] Comma-separated list of allowed CORS origins.
# Production: set to your actual domain (e.g., https://cinevault.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080

# ─── API Documentation ────────────────────────────────────────────────────────
# [OPTIONAL] [PUBLIC] Enable Swagger/ReDoc UI. Defaults: true (dev), false (production)
DOCS_ENABLED=true

# ─── Object Storage (S3-compatible) ──────────────────────────────────────────
# [OPTIONAL] [PUBLIC] S3/MinIO endpoint for artwork and raw payloads
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_RAW_PAYLOADS_BUCKET=cinevault-dev-raw-payloads
S3_ARTWORK_BUCKET=cinevault-dev-artwork

# [OPTIONAL] [SECRET] S3 credentials
S3_ACCESS_KEY_ID=dev_s3_access_key
S3_SECRET_ACCESS_KEY=dev_s3_secret_key

# ─── Observability & Telemetry ────────────────────────────────────────────────
# [OPTIONAL] [PUBLIC] Telemetry endpoints (disabled gracefully if unreachable)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# ─── AI Provider Integration ─────────────────────────────────────────────────
# [OPTIONAL] [PUBLIC] AI provider selection.
# Values: mock (default for dev/tests) | openai | gemini | groq | grok
# If unset, auto-detects from available API keys. Set explicitly to "mock" to
# force mock mode even when API keys are present.
AI_PROVIDER=mock

# [OPTIONAL] [SECRET] OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# [OPTIONAL] [SECRET] Google Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# [OPTIONAL] [SECRET] Groq (free-tier LLM API) configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# [OPTIONAL] [SECRET] xAI Grok configuration
GROK_API_KEY=
GROK_MODEL=grok-4

# ─── Ingestion Provider Integration ──────────────────────────────────────────
# [OPTIONAL] [PUBLIC] Ingestion mode. Values: mock (default) | live
INGESTION_MODE=mock

# [OPTIONAL] [SECRET] External data provider API keys
PROVIDER_API_KEY=
KOBIS_API_KEY=
TMDB_API_KEY=
TVDB_API_KEY=
