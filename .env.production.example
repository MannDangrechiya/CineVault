# CineVault OS — Production Environment Template
# Copy to .env.prod and fill in ALL values before deploying.
#
# ⚠️  EVERY [SECRET] variable below MUST be changed from its placeholder.
#     The application will REFUSE TO START in production mode with default secrets.

ENVIRONMENT=production
LOG_LEVEL=warning

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cinevault
POSTGRES_USER=cinevault_admin
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD_HERE>

# ─── PgBouncer ────────────────────────────────────────────────────────────────
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# ─── Valkey Cache ─────────────────────────────────────────────────────────────
VALKEY_HOST=valkey
VALKEY_PORT=6379

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=cinevault_app
RABBITMQ_PASS=<GENERATE_STRONG_PASSWORD_HERE>

# ─── Authentication ──────────────────────────────────────────────────────────
# For production: configure Keycloak OIDC or set JWT_SECRET_KEY to a
# cryptographically random 64+ character string.
JWT_SECRET_KEY=<GENERATE_64_CHAR_RANDOM_STRING_HERE>

# If using Keycloak:
# KEYCLOAK_HOST=https://auth.yourdomain.com
# KEYCLOAK_REALM=cinevault
# KEYCLOAK_CLIENT_ID=cinevault-public-client

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set to your actual production domain(s), comma-separated
CORS_ALLOWED_ORIGINS=https://cinevault.yourdomain.com

# ─── API Documentation ───────────────────────────────────────────────────────
# Disabled by default in production. Set to true if you want Swagger UI.
DOCS_ENABLED=false

# ─── S3 Storage ───────────────────────────────────────────────────────────────
S3_ACCESS_KEY_ID=<YOUR_S3_ACCESS_KEY>
S3_SECRET_ACCESS_KEY=<YOUR_S3_SECRET_KEY>

# ─── AI Provider (OPTIONAL) ──────────────────────────────────────────────────
# Leave AI_PROVIDER unset to auto-detect from available keys,
# or set to "mock" to disable AI features entirely (free-first default).
# AI_PROVIDER=grok
# GROK_API_KEY=<YOUR_GROK_API_KEY>
# GROK_MODEL=grok-4

# ─── Caddy / HTTPS ───────────────────────────────────────────────────────────
# Set to your domain for automatic HTTPS via Let's Encrypt:
# SITE_ADDRESS=cinevault.yourdomain.com
# Or leave unset for HTTP-only (when behind another reverse proxy).
