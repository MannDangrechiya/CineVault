{
  "realm": "cinevault-dev",
  "displayName": "CineVault OS Development Realm",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 3600,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "roles": {
    "realm": [
      {
        "name": "Anonymous",
        "description": "Unauthenticated catalog viewer role"
      },
      {
        "name": "AuthenticatedUser",
        "description": "Standard authenticated user role"
      },
      {
        "name": "Curator",
        "description": "Control Room moderator and evidence reconciliation curator role"
      },
      {
        "name": "SystemAdmin",
        "description": "CineVault OS system administrator role"
      },
      {
        "name": "ingestion_write",
        "description": "Ingestion worker payload capture permission"
      },
      {
        "name": "quality_write",
        "description": "Data quality quarantine processing permission"
      },
      {
        "name": "sync_write",
        "description": "Offline sync mutation processing permission"
      },
      {
        "name": "analytics_read",
        "description": "Read-only analytics permission"
      }
    ]
  },
  "clients": [
    {
      "clientId": "cinevault-public-client",
      "name": "CineVault Public Client (Web / Mobile App)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8000",
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "cinevault-api-gateway",
      "name": "CineVault Kong API Gateway",
      "enabled": true,
      "publicClient": false,
      "secret": "dev_api_gateway_secret_change_me",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "cinevault-ingest-service",
      "name": "CineVault Ingestion Pipeline Service",
      "enabled": true,
      "publicClient": false,
      "secret": "dev_ingest_service_secret_change_me",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "cinevault-quality-service",
      "name": "CineVault Data Quality Engine Service",
      "enabled": true,
      "publicClient": false,
      "secret": "dev_quality_service_secret_change_me",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "cinevault-sync-service",
      "name": "CineVault Offline Sync Service",
      "enabled": true,
      "publicClient": false,
      "secret": "dev_sync_service_secret_change_me",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "dev_user",
      "enabled": true,
      "email": "dev_user@cinevault.local",
      "firstName": "Development",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "dev_user_pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "AuthenticatedUser"
      ]
    },
    {
      "username": "dev_curator",
      "enabled": true,
      "email": "dev_curator@cinevault.local",
      "firstName": "Development",
      "lastName": "Curator",
      "credentials": [
        {
          "type": "password",
          "value": "dev_curator_pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "AuthenticatedUser",
        "Curator"
      ]
    },
    {
      "username": "dev_admin",
      "enabled": true,
      "email": "dev_admin@cinevault.local",
      "firstName": "Development",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "dev_admin_pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "AuthenticatedUser",
        "Curator",
        "SystemAdmin"
      ]
    }
  ]
}
