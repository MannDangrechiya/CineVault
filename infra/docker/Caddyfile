# CineVault OS — Production Edge Gateway & Reverse Proxy (Caddy v2)
# Handles automatic HTTPS (Let's Encrypt), HTTP->HTTPS redirect, Brotli/Zstandard/Gzip
# compression, security headers, and routing between FastAPI Backend, Next.js Web
# Frontend, and Keycloak.
#
# REQUIRES SITE_ADDRESS and KEYCLOAK_HOSTNAME to be set (see docker-compose.prod.yml
# / .env.production.example) to real production domains, e.g.:
#   SITE_ADDRESS=cinevault.yourdomain.com
#   KEYCLOAK_HOSTNAME=auth.cinevault.yourdomain.com
# A bare domain as the site address (no scheme, no port) is what makes Caddy
# provision and auto-renew a Let's Encrypt certificate and automatically serve
# plain HTTP on :80 that redirects to HTTPS on :443 — no separate :80 block is
# needed or should be added here. Do NOT hardcode a bare `:80 { ... }` site in
# production: that serves the whole app over unencrypted HTTP with no certificate
# and no redirect, which is the exact gap this file used to have.
{
    admin off
    persist_config off
    # Let's Encrypt only uses this for optional expiry/problem notifications —
    # it doesn't verify ownership, so a harmless fallback here is fine, but
    # you should set ACME_EMAIL to a real inbox you actually monitor.
    email {$ACME_EMAIL:ops@example.com}
}

{$SITE_ADDRESS} {
    # Logging
    log {
        output stdout
        format console
    }

    # Compression
    encode zstd gzip

    # Hardened Security Headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # NOTE: no Content-Security-Policy header here yet — deliberately left out
    # of this pass (scoped to Keycloak + TLS). Adding one needs to be checked
    # against what apps/web's Next.js build actually emits (inline hydration
    # scripts, external image hosts like TMDB/CDN_BASE_URL) before shipping,
    # or it will break the app it's supposed to protect. Tracked as separate
    # follow-up work, not silently dropped.

    # 1. API & Backend Service Routes -> FastAPI
    handle /v1/* {
        reverse_proxy fastapi-backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /ai/* {
        reverse_proxy fastapi-backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /social/* {
        reverse_proxy fastapi-backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /automations/* {
        reverse_proxy fastapi-backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /internal/* {
        reverse_proxy fastapi-backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /health* {
        reverse_proxy fastapi-backend:8000
    }

    handle /metrics* {
        reverse_proxy fastapi-backend:8000
    }

    handle /docs* {
        reverse_proxy fastapi-backend:8000
    }

    handle /openapi.json {
        reverse_proxy fastapi-backend:8000
    }

    # 2. Web Application Frontend -> Next.js Standalone Runner
    handle /* {
        reverse_proxy nextjs-web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# 3. Identity Provider -> Keycloak (separate domain, own Let's Encrypt cert)
{$KEYCLOAK_HOSTNAME} {
    log {
        output stdout
        format console
    }

    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    reverse_proxy keycloak:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 4. Artwork CDN -> MinIO (separate domain, own Let's Encrypt cert). Proxied
# 1:1 at the root so path-style object URLs (/<bucket>/<key>) resolve exactly
# as boto3 wrote them — see fastapi-backend's CDN_BASE_URL in
# docker-compose.prod.yml and services/api/storage.py's build_public_url.
# Only GET/HEAD reach here in practice: the artwork bucket is set to
# anonymous *download* only (packages bootstrapped by the minio-init service
# — no anonymous list/write), so this proxies public reads, not the S3 write
# API surface.
{$CDN_HOSTNAME} {
    log {
        output stdout
        format console
    }

    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    reverse_proxy minio:9000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
