# CineVault OS — Production Edge Gateway & Reverse Proxy (Caddy v2)
# Handles automatic HTTPS (Let's Encrypt), HTTP->HTTPS redirect, Brotli/Zstandard/Gzip
# compression, security headers, and routing between FastAPI Backend and
# Next.js Web Frontend. Keycloak was removed in the Phase 3 infrastructure
# consolidation — native HS256 auth (already the only thing FastAPI actually
# issues) is the sole authentication mechanism now, so there is no separate
# identity-provider domain to route to.
#
# REQUIRES SITE_ADDRESS to be set (see docker-compose.prod.yml /
# .env.production.example) to a real production domain, e.g.:
#   SITE_ADDRESS=cinevault.yourdomain.com
# A bare domain as the site address (no scheme, no port) is what makes Caddy
# provision and auto-renew a Let's Encrypt certificate and automatically serve
# plain HTTP on :80 that redirects to HTTPS on :443 — no separate :80 block is
# needed or should be added here. Do NOT hardcode a bare `:80 { ... }` site in
# production: that serves the whole app over unencrypted HTTP with no certificate
# and no redirect, which is the exact gap this file used to have.
{
    admin off
    persist_config off
    # Let's Encrypt only uses this for optional expiry/problem notifications —
    # it doesn't verify ownership, so a harmless fallback here is fine, but
    # you should set ACME_EMAIL to a real inbox you actually monitor.
    email {$ACME_EMAIL:ops@example.com}
}

{$SITE_ADDRESS} {
    # Logging
    log {
        output stdout
        format console
    }

    # Compression
    encode zstd gzip

    # Hardened Security Headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # NOTE: no Content-Security-Policy header here yet — deliberately left out
    # of this pass (scoped to Keycloak + TLS). Adding one needs to be checked
    # against what apps/web's Next.js build actually emits (inline hydration
    # scripts, external image hosts like TMDB/CDN_BASE_URL) before shipping,
    # or it will break the app it's supposed to protect. Tracked as separate
    # follow-up work, not silently dropped.
    #
    # R1 hardening pass: the CDN hostname is no longer hardcoded anywhere in
    # apps/web (see next.config.ts / lib/media.ts) — when a CSP is added, its
    # img-src should reference {$CDN_HOSTNAME}, the same Caddy env-var
    # templating already used for the site blocks below, not a literal
    # domain. That unblocks the CSP work started here, it does not finish it.

    # 1. API & Backend Service Routes -> FastAPI
    handle /v1/* {
        reverse_proxy fastapi-backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /ai/* {
        reverse_proxy fastapi-backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /social/* {
        reverse_proxy fastapi-backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /automations/* {
        reverse_proxy fastapi-backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # R1 hardening pass: services/api/routers/{jobs,performance,observability}.py
    # only check that an X-Service-Identity header is present and non-empty —
    # that is NOT cryptographic authentication, it's trivially spoofable by
    # anyone on the public internet setting the same header themselves.
    # Nothing outside this Docker network legitimately calls these three
    # route groups (verified: no caller anywhere in the repo reaches them
    # over HTTP). A future internal caller can reach fastapi-backend:8000
    # directly over the internal network without going through this public
    # proxy at all, so blocking them here costs nothing. Placed before the
    # general /internal/* handler below since Caddy's `handle` matches in
    # file order. Real service-to-service auth for these three routers is
    # tracked as follow-up work — this only closes the public-edge exposure.
    handle /internal/v1/jobs/* {
        respond 404
    }

    handle /internal/v1/performance/* {
        respond 404
    }

    handle /internal/v1/observability/* {
        respond 404
    }

    # Everything else under /internal/* (ingestion, reconciliation,
    # control-room curation, AI proposal review, artwork upload) requires a
    # real native JWT with Curator/SystemAdmin role (see
    # services/api/auth/dependencies.py's require_curator/require_system_admin)
    # — safe to keep public; the mobile app's Control Room screens depend on
    # reaching these routes through this domain.
    handle /internal/* {
        reverse_proxy fastapi-backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /health* {
        reverse_proxy fastapi-backend:8000
    }

    # R1 hardening pass: /metrics (services/api/routers/metrics.py) is
    # Prometheus text-format output with zero authentication, and unlike the
    # dev stack, this production Compose file ships no Prometheus scraper
    # that would need it reachable here — nothing legitimate consumes this
    # publicly today. Blocked at the edge; an internal scraper, if one is
    # added later, can reach fastapi-backend:8000/metrics directly over the
    # Docker network without needing this public route reopened.
    handle /metrics* {
        respond 404
    }

    # /docs, /redoc, and /openapi.json are already gated by DOCS_ENABLED
    # (docker-compose.prod.yml sets it to "false" in production, and
    # services/api/main.py registers no route at all for these paths when
    # it's false) — FastAPI itself 404s here in production, so no additional
    # edge-level block is needed on top of that app-level control.
    handle /docs* {
        reverse_proxy fastapi-backend:8000
    }

    handle /openapi.json {
        reverse_proxy fastapi-backend:8000
    }

    # 2. Web Application Frontend -> Next.js Standalone Runner
    handle /* {
        reverse_proxy nextjs-web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# 3. Artwork CDN -> MinIO (separate domain, own Let's Encrypt cert). Proxied
# 1:1 at the root so path-style object URLs (/<bucket>/<key>) resolve exactly
# as boto3 wrote them — see fastapi-backend's CDN_BASE_URL in
# docker-compose.prod.yml and services/api/storage.py's build_public_url.
# Only GET/HEAD reach here in practice: the artwork bucket is set to
# anonymous *download* only (packages bootstrapped by the minio-init service
# — no anonymous list/write), so this proxies public reads, not the S3 write
# API surface.
{$CDN_HOSTNAME} {
    log {
        output stdout
        format console
    }

    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    reverse_proxy minio:9000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
