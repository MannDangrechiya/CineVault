{
  "realm": "cinevault",
  "displayName": "CineVault OS",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 3600,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "roles": {
    "realm": [
      { "name": "Anonymous", "description": "Unauthenticated catalog viewer role" },
      { "name": "AuthenticatedUser", "description": "Standard authenticated user role" },
      { "name": "Curator", "description": "Control Room moderator and evidence reconciliation curator role" },
      { "name": "SystemAdmin", "description": "CineVault OS system administrator role" },
      { "name": "ingestion_write", "description": "Ingestion worker payload capture permission" },
      { "name": "quality_write", "description": "Data quality quarantine processing permission" },
      { "name": "sync_write", "description": "Offline sync mutation processing permission" },
      { "name": "analytics_read", "description": "Read-only analytics permission" }
    ]
  },
  "clients": [
    {
      "clientId": "cinevault-public-client",
      "name": "CineVault Public Client (Web / Mobile App)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://__SITE_ADDRESS__/*"
      ],
      "webOrigins": [
        "https://__SITE_ADDRESS__"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "cinevault-api-gateway",
      "name": "CineVault Kong API Gateway",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "cinevault-ingest-service",
      "name": "CineVault Ingestion Pipeline Service",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "cinevault-quality-service",
      "name": "CineVault Data Quality Engine Service",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "cinevault-sync-service",
      "name": "CineVault Offline Sync Service",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false
    }
  ]
}
